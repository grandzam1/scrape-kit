# Copy to .env — never commit this file.
# Lab CLI needs COMPOSIO_*; Deno Deploy needs the full production set (see README).

COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_USER_ID=your_composio_user_uuid

# Required on Deno for Airtable runs log
# COMPOSIO_AIRTABLE_ACCOUNT_ID=ca_xxx
# AIRTABLE_BASE_ID=appxxx
# AIRTABLE_TABLE=runs

# Deno Deploy production
# FIRECRAWL_API_KEY=fc-xxx
# GROQ_API_KEY=gsk_xxx
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_CHUNK_CHARS=4500
# GROQ_TPM_BUDGET=6500
# GROQ_MAX_CHUNKS=2
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPO=grandzam1/scrape-kit
# GITHUB_BRANCH=main
# SCRAPE_SECRET=change-me
