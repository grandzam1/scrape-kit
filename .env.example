# Copy to .env — never commit this file.

COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_USER_ID=your_composio_user_uuid

# Optional Composio pins
# COMPOSIO_PROJECT_ID=pr_xxx
# COMPOSIO_ORG_ID=ok_xxx
# COMPOSIO_GOOGLE_ACCOUNT_ID=ca_xxx
# GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
# GOOGLE_SHEETS_TAB=runs

# Deno HTTP runner (set these on Deno Deploy, not required for local CLI)
# FIRECRAWL_API_KEY=fc-xxx
# GROQ_API_KEY=gsk_xxx
# GROQ_MODEL=llama-3.3-70b-versatile
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPO=grandzam1/scrape-kit
# GITHUB_BRANCH=main
# SCRAPE_SECRET=change-me
